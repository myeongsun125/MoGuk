[
  {"text_ko": "멈춰 주세요!", "text_vi": "Hãy dừng lại!", "text_in": "Tolong berhenti!", "high_risk": true, "note": "비상정지 시 주변에 알리는 최우선 문장. (선반 §6.3, 프레스 §6.3)", "draft": true},
  {"text_ko": "위험합니다!", "text_vi": "Nguy hiểm!", "text_in": "Bahaya!", "high_risk": true, "note": "위험을 즉시 알리는 경고 문장.", "draft": true},
  {"text_ko": "손을 넣지 마세요!", "text_vi": "Không đưa tay vào!", "text_in": "Jangan masukkan tangan!", "high_risk": true, "note": "프레스 금형 끼임 예방 최우선 경고. (프레스 §4.1)", "draft": true},
  {"text_ko": "도와주세요!", "text_vi": "Xin hãy giúp tôi!", "text_in": "Tolong saya!", "high_risk": true, "note": "재해 발생 시 구조 요청.", "draft": true},
  {"text_ko": "다쳤어요.", "text_vi": "Tôi bị thương rồi.", "text_in": "Saya terluka.", "high_risk": true, "note": "부상 신고 문장.", "draft": true},
  {"text_ko": "기동합니다.", "text_vi": "Tôi khởi động máy đây.", "text_in": "Saya nyalakan mesinnya.", "high_risk": false, "note": "2인 이상 작업 시 기동 전 상호 확인 문장. (선반 §4.1, 프레스 §4.1)", "draft": true},
  {"text_ko": "이해했습니다.", "text_vi": "Tôi đã hiểu.", "text_in": "Saya mengerti.", "high_risk": false, "note": "지시 확인 응답.", "draft": true},
  {"text_ko": "잘 모르겠습니다.", "text_vi": "Tôi không hiểu rõ.", "text_in": "Saya kurang mengerti.", "high_risk": false, "note": "모르는 채로 작업하는 것을 막는 문장.", "draft": true},
  {"text_ko": "다시 말해 주세요.", "text_vi": "Xin hãy nói lại một lần nữa.", "text_in": "Tolong ulangi sekali lagi.", "high_risk": false, "note": "재확인 요청 문장.", "draft": true},
  {"text_ko": "관리자님을 불러 주세요.", "text_vi": "Xin hãy gọi quản lý giúp tôi.", "text_in": "Tolong panggilkan penyelia.", "high_risk": false, "note": "이상 발견·보고 시 사용. (선반 §3.1, 프레스 §3.1)", "draft": true}
]
