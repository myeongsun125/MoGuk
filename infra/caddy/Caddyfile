# MoGuk edge 리버스 프록시 — 병갑 [infra]
# SITE_ADDRESS 미설정 → :80(http, 로컬 dev) / 도메인 지정(예: moguk.ai.kr) → Caddy 자동 TLS(Let's Encrypt) + http→https 리다이렉트
{$SITE_ADDRESS} {
        @admin {
                path /api/v1/admin/*
                not remote_ip {$ADMIN_ALLOW_IPS}
        }
        handle @admin {
                respond "admin access restricted" 403
        }
        handle /api/* {
                reverse_proxy edge-api:8000
        }
        handle /health {
                reverse_proxy edge-api:8000
        }
        handle {
                reverse_proxy frontend:80
        }
}



