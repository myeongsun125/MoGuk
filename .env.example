# cp .env.example .env 후 값 채움. .env 는 커밋 금지(.gitignore). 시크릿은 값 없이 키만 둔다.

# ── DB (postgres) ──
POSTGRES_USER=moguk
POSTGRES_PASSWORD=
POSTGRES_DB=moguk

# ── 시크릿 ──
EXTERNAL_LLM_API_KEY=
TENANT_CRYPTO_KEY=
JWT_SECRET=

# ── 앱 ──
APP_VERSION=0.1.0-dev
APP_SLOT=dev

# ── LLM / STT (M-03, M-18) ──
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=qwen3:4b
OLLAMA_KEEP_ALIVE=10m
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# ── 이미지 자리(profile full) ──
STT_IMAGE=
DAGSTER_IMAGE=

# ── edge-db (M-23 자리, profile full) ──
EDGE_DB_USER=edge
EDGE_DB_PASSWORD=
EDGE_DB_NAME=edge

# ── prod ──
CADDY_DOMAIN=
