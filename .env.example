# cp .env.example .env 후 값 채움. .env 는 커밋 금지(.gitignore). 시크릿은 값 없이 키만 둔다.

# ── DB (postgres) ──
POSTGRES_USER=moguk
POSTGRES_PASSWORD=
POSTGRES_DB=moguk

# ── 시크릿 ──
EXTERNAL_LLM_API_KEY=
TENANT_CRYPTO_KEY=
JWT_SECRET=

# ── 앱 ──
APP_VERSION=0.1.0-dev
APP_SLOT=dev

# ── LLM / STT (M-03, M-18) ──
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=qwen3:4b
# ollama 모델 상주 시간 — core가 요청마다 전송(llm_adapter). 기본 10m은 10분 유휴 시 언로드→콜드 22~81s(0831 리허설 원인). 운영 권고 24h
OLLAMA_KEEP_ALIVE=24h
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# ── 이미지 자리(profile full) ──
STT_IMAGE=
DAGSTER_IMAGE=

# ── edge-db (M-23 자리, profile full) ──
EDGE_DB_USER=edge
EDGE_DB_PASSWORD=
EDGE_DB_NAME=edge

# ── prod ──
CADDY_DOMAIN=

# ── S3 미디어 버퍼 (M-25) — edge=write-only / core=read+delete, 교차 사용 금지 ──
S3_BUCKET=
S3_REGION=ap-northeast-2
EDGE_S3_ACCESS_KEY_ID=
EDGE_S3_SECRET_ACCESS_KEY=
CORE_S3_ACCESS_KEY_ID=
CORE_S3_SECRET_ACCESS_KEY=

# ── LLM 어댑터·RAG (M-30 확정 / #8·#13·#14 소비) — core-api 소속 ──
LLM_TIMEOUT_LOCAL_S=25.0
LLM_TIMEOUT_EXTERNAL_S=8.0
LLM_DEADLINE_S=27.0
LLM_NUM_PREDICT=200
LLM_PROBE_TIMEOUT_S=2.0
EXTERNAL_LLM_PROVIDER=openai
EXTERNAL_LLM_MODEL=gpt-4o-mini
EXTERNAL_LLM_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=bge-m3
TENANT_SLUG=axis_demo
LOG_LEVEL=INFO

# ── 되번역 게이트 (M-34 c / core 전용) — τ 미달 시 answer 차단(gated, gate_reason='threshold') ──
GATE_TAU=0.80
BACKTRANS_TIMEOUT_S=10.0
GATE_SRC=question              # question | chunks — 게이트 축(질문 원문 / 근거 결합문). 두 점수는 trace 에 병기

# ── ollama (기존 소비 — M-28a 아님) ──
OLLAMA_URL=http://ollama:11434

# ── 릴레이 (M-28a / #17 소비) — HOLD_S만 edge·core 양쪽, 나머지 edge ──
RELAY_HOLD_S=20
RELAY_BATCH_MAX=10
RELAY_EDGE_WAIT_S=30
RELAY_LEASE_S=60
RELAY_REDELIVER_MAX=1

# ── 초대 발급 (M-32 / core) — invite_url 접두. 값 확정은 BG ──
BASE_URL=http://localhost

# ── jobs 러너 (M-33 / core 전용) — 큐가 비었을 때 폴링 간격(초) ──
JOBS_POLL_S=2.0

# ── 인증·하트비트 (#24 소비) — JWT 2종 edge·core 양쪽, HEARTBEAT core ──
JWT_ACCESS_TTL_S=1800
JWT_REFRESH_TTL_S=1209600
HEARTBEAT_INTERVAL_S=30

# ── Caddy 사이트 주소 — 미지정 :80(http) / 도메인 지정 시 HTTPS 자동발급 (prod: moguk.ai.kr) ──
SITE_ADDRESS=
